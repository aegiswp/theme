# Dependencies
node_modules/
# Ignore Composer-managed packages, but keep the vendored first-party Aegis
# framework packages tracked: they are path-repository sources required for
# `composer install` to resolve aegis/framework and aegis/icons on a fresh
# clone (see "repositories" in composer.json).
# Per-package composer.json and LICENSE stay in Git; README is optional dev docs.
# .distignore strips nested composer.json/README/etc. from the release zip.
vendor/*
!vendor/aegis/
!vendor/aegis/**

# Re-ignore generated/dev paths inside tracked first-party packages.
vendor/aegis/**/tests/
vendor/aegis/**/node_modules/
vendor/aegis/**/vendor/
vendor/aegis/**/.phpunit.cache/
vendor/aegis/wpaudit/

# IDE
.vscode/
.idea/
.claude/
.cursor/
.fleet/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Dot-prefixed folders/files in patterns (e.g. .template/)
patterns/.*

# Ephemeral / scratch (e.g. *.pretty.tmp from local formatting)
*.tmp
*.temp
*.bak
*.backup

# Dev tooling — maintained scripts under tools/ ARE tracked (see tools/README.md).
# Do not upload: local probes, Composer install output, caches.
# WPAudit lives only in tools/wpaudit/; ignore a leftover vendor copy.
tools/scratch/
tools/wpaudit/vendor/
tools/wpaudit/.phpunit.cache/
tools/wpaudit/coverage/
tools/wpaudit/.github/
tools/wpaudit/audit-report.html
.wpauditrc.json

# One-off dev/migration scripts (not part of theme runtime).
# Unanchored `bin/` also matches vendor/bin/ (Composer binaries) — intentional.
bin/
scripts/

# Empty / legacy (not part of theme runtime)
config/

# Test coverage
.phpunit.result.cache
.phpunit.cache/
.phpcs.cache
coverage/
coverage.xml
*.coverage
phpunit-report.xml

# E2E / browser testing (if added under the theme)
playwright-report/
test-results/

# Build artifacts — src/Blocks/ (webpack output)
src/Blocks/*/index.js
src/Blocks/*/view.js
src/Blocks/*/style.js
src/Blocks/*/index.css
src/Blocks/*/style.css
src/Blocks/*/style-index.css
src/Blocks/*/style-style.css
src/Blocks/*/*.asset.php
src/Blocks/*/*.js.map
src/Blocks/*/*.css.map
src/Blocks/*/*-rtl.css

# Build artifacts — src/Blocks/editor/ (webpack output)
src/Blocks/editor/

# Build artifacts — general
/build/
/dist/
/aegis/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local

# wp-env (local-only overrides; base config is .wp-env.json in repo)
.wp-env.override.json

# Composer HTTP basic auth (private packages) — never commit
auth.json

# Local dev stacks (keep machine-specific config out of git)
.ddev/
.vagrant/

# Cache
.cache/
.eslintcache
.stylelintcache
.pnpm-store/
/.kiro
SUBMISSION-NOTES.md
