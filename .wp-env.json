{
	"$schema": "https://json.schemastore.org/wp-env",
	"core": null,
	"phpVersion": "8.3",
	"port": 8888,
	"testsPort": 8889,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local"
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp theme activate aegis"
	},
	"mappings": {
		"wp-content/themes/aegis": "."
	}
}
