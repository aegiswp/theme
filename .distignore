# Installable theme zip (WordPress) — not the full dev repository.
# Consumed by: .github/workflows/release.yml (rsync --exclude-from=.distignore).
# Keep: templates, parts, patterns markup, theme.json, style.css, functions.php,
# compiled block JS/CSS, languages, runtime `vendor/`, and theme `assets/`.
# After changes here, align export-ignore in .gitattributes for `git archive` parity.

# Git / VCS

.git/
.gitattributes
.gitignore
.distignore

# GitHub / agent / IDE metadata

.github/
.claude/
.cursor/
.kiro/
.vscode/
.idea/
.fleet/

# Node.js / build tooling

node_modules/
package.json
package-lock.json
webpack.config.js
tsconfig.json
eslint.config.cjs
.nvmrc
*.code-workspace

# Composer files (vendor/ runtime deps are included; manifest files are not needed by end users)

composer.json
composer.lock

# Nested vendor package metadata (runtime uses vendor/composer/autoload; keep LICENSE files)

vendor/*/composer.json
vendor/*/*/composer.json
vendor/**/ICONS-REGISTRY.md
vendor/**/CHANGELOG.md
vendor/**/README.md
vendor/**/tests/
vendor/aegis/**/tests/

# Vendor dev dependencies

vendor/bin/
vendor/phpunit/
vendor/giorgiosironi/
vendor/dealerdirect/
vendor/phpcsstandards/
vendor/phpcompatibility/
vendor/squizlabs/
vendor/wp-coding-standards/
vendor/wptrt/

# Editor, lint, env

.wp-env.json
.wp-env.override.json
.editorconfig
.prettierrc
.stylelintignore
.stylelintrc.json
.typos.toml
.pa11yci.json
.env
.env.*
auth.json
docker-compose*.yml
docker-compose*.yaml
playwright-report/
test-results/

# Documentation and community files

README.md
BUILD.md
INSTRUCTIONS.md
DESIGN.md
CHANGELOG.md
CONTRIBUTING.md
CONTRIBUTORS.md
CODE_OF_CONDUCT.md
SUBMISSION-NOTES.md
AGENTS.md
CLAUDE.md
STUDIO.md

# Development / test tooling

Makefile
phpcs.xml
phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
tests/
.nyc_output/
coverage/
coverage.xml
.phpunit.result.cache
.phpunit.cache/
.phpcs.cache
*.log

# Stray vendor / build temp files

*.tmp
*.temp
*.bak
*.backup

# Build artifacts, source maps, and cache

.cache/
.eslintcache
.stylelintcache
build/
dist/
aegis/
src/Blocks/*/*.js.map
src/Blocks/*/*.css.map
src/Blocks/editor/

# Audit tool (standalone dev package, not part of theme runtime)

tools/

# One-off dev/migration scripts (not part of theme runtime)

bin/
scripts/

# Block source files (only compiled output needed)

src/Blocks/*/index.tsx
src/Blocks/*/edit.tsx
src/Blocks/*/save.tsx
src/Blocks/*/view.ts
src/Blocks/*/style.scss

# Docs

docs/

# Dev-only pattern docs (optional; safe to include on disk, omit from dist)

patterns/README.txt

# Empty / legacy

config/
