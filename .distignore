# Installable theme zip (WordPress) — not the full dev repository.
# Consumed by: .github/workflows/release.yml (rsync --exclude-from=.distignore).
# Keep: templates, parts, patterns markup, theme.json, style.css, functions.php,
# compiled block JS/CSS, runtime `vendor/`, and theme `assets/`.
# Omit: languages/ and the root license file (both LICENSE and LICENCE spellings).
# After changes here, align export-ignore in .gitattributes for `git archive` parity.

# Git / VCS

.git/
.gitattributes
.gitignore
.distignore

# GitHub / editor metadata — not shipped in the installable zip

.github/
.vscode/

# Node.js / build tooling

node_modules/
package.json
package-lock.json
webpack.config.js
tsconfig.json
eslint.config.cjs
.nvmrc
*.code-workspace

# Composer files (vendor/ runtime deps are included; manifest files are not needed by end users)

composer.json
composer.lock

# Nested vendor package metadata (runtime uses vendor/composer/autoload; keep LICENSE files)

vendor/*/composer.json
vendor/*/*/composer.json
vendor/**/ICONS-REGISTRY.md
vendor/**/CHANGELOG.md
vendor/**/README.md
vendor/**/tests/
vendor/aegis/**/tests/

# Audit tool (standalone, not theme runtime). `tools/` excludes the
# contributor tree; `vendor/aegis/wpaudit/` is a leftover-path guard.

tools/
tools/wpaudit/
vendor/aegis/wpaudit/

# Vendor dev dependencies (safety net if a zip is built without --no-dev)

vendor/bin/
vendor/dealerdirect/
vendor/giorgiosironi/
vendor/myclabs/
vendor/nikic/
vendor/phar-io/
vendor/phpcompatibility/
vendor/phpcsstandards/
vendor/phpunit/
vendor/sebastian/
vendor/squizlabs/
vendor/theseer/
vendor/wp-coding-standards/
vendor/wptrt/

# Nested install/cache inside first-party path packages (not theme runtime)

vendor/aegis/**/node_modules/
vendor/aegis/**/vendor/
vendor/aegis/**/.phpunit.cache/

# Editor, lint, env

.wp-env.json
.wp-env.override.json
.editorconfig
.prettierrc
.stylelintignore
.stylelintrc.json
.typos.toml
.pa11yci.json
.pa11yci.ci.json
.env
.env.*
auth.json
docker-compose*.yml
docker-compose*.yaml
playwright-report/
test-results/

# Documentation and community files

README.md
BUILD.md
INSTRUCTIONS.md
DESIGN.md
CHANGELOG.md
CONTRIBUTING.md
CONTRIBUTORS.md
CODE_OF_CONDUCT.md
SUBMISSION-NOTES.md
AGENTS.md
CLAUDE.md
STUDIO.md

# Development / test tooling

Makefile
phpcs.xml
phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
tests/
.nyc_output/
coverage/
coverage.xml
.phpunit.result.cache
.phpunit.cache/
.phpcs.cache
*.log

# Stray vendor / build temp files

*.tmp
*.temp
*.bak
*.backup

# Build artifacts, source maps, and cache

.cache/
.eslintcache
.stylelintcache
build/
dist/
# Release staging folder at the repo root only (anchored: an unanchored
# "aegis/" would also exclude vendor/aegis/, the framework).
/aegis/
src/Blocks/*/*.js.map
src/Blocks/*/*.css.map
src/Blocks/editor/
src/types/

# One-off dev/migration scripts (not part of theme runtime)

bin/
scripts/

# Block source files (only compiled output needed)

src/Blocks/*/index.tsx
src/Blocks/*/edit.tsx
src/Blocks/*/save.tsx
src/Blocks/*/view.ts
src/Blocks/*/style.scss

# Docs

docs/

# Translations and the theme license stay in the repository, not the release zip.
# Root-anchored so vendor/*/LICENSE files still ship with their packages.

/languages/
/LICENSE
/LICENCE

# Dev-only pattern docs (optional; safe to include on disk, omit from dist)

patterns/README.txt

# Local-only leading-dot pattern drafts (never ship)

patterns/**/.*

# Internal marketing patterns (live site only — not in theme zip)

patterns/custom/

# Empty / legacy

config/

# Stray temp/scratch files
_tmp_*
