    "custom": {
      "spacing": {
        "gap": "var(--wp--style--block-gap)"
      },
      "border": {
        "width": "1px",
        "style": "solid",
        "color": "var(--wp--preset--color--neutral-200)",
        "radius": "6px"
      },
      "boxShadow": {
        "inset": "",
        "x": "0",
        "y": "4px",
        "blur": "16px",
        "spread": "0",
        "color": "var(--wp--preset--color--shadow)",
        "hover": {
          "inset": "",
          "y": "8px"
        }
      },
      "fontWeight": {
        "black": 900,
        "extrabold": 800,
        "bold": 700,
        "semibold": 600,
        "medium": 500,
        "normal": 400,
        "light": 300,
        "extralight": 200,
        "thin": 100
      },
      "transition": {
        "property": "all",
        "duration": "0.1s",
        "timingFunction": "ease-in"
      },
      "strong": {
        "fontWeight": "var(--wp--custom--font-weight--medium)"
      },
      "checklist": {
        "color": "var(--wp--preset--color--success-600)"
      },
      "surface": {
        "backdropFilter": "blur(8px)",
        "borderRadius": "var(--wp--custom--border--radius)",
        "boxShadow": "none",
        "border": {
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0"
        },
        "overlay": {
          "background": "var(--wp--preset--color--neutral-50)",
          "opacity": ".5"
        },
        "input": {
          "focus": {
            "borderColor": "var(--wp--preset--color--primary-500)"
          }
        }
      },
      "darkMode": {
        "palette": {
          "neutral-400": "#949494",
          "neutral-500": "#a3a3a3",
          "success-100": "#052e1f",
          "warning-100": "#3a2603",
          "error-100": "#3b0a14",
          "info-100": "#0a2540"
        }
      },
      "subHeading": {
        "color": "var(--wp--preset--color--primary-600)",
        "lineHeight": "1.25"
      },
      "buttonOutline": {
        "color": "var(--wp--preset--color--primary-500)",
        "borderWidth": "1px"
      },
      "ghost": {
        "color": "var(--wp--preset--color--primary-600)"
      },
      "input": {
        "background": "transparent",
        "focus": {
          "boxShadow": "var(--wp--preset--shadow--sm)",
          "borderColor": "var(--wp--preset--color--primary-500)"
        }
      },
      "placeholder": {
        "background": "var(--wp--preset--color--neutral-100)"
      },
      "icon": {
        "color": "currentcolor"
      },
      "notice": {
        "color": "var(--wp--preset--color--primary-500)"
      },
      "callout": {
        "borderWidth": "4px",
        "padding": "1em 1em 1em 1.5em",
        "backgroundOpacity": "0.06",
        "borderColor": "var(--wp--preset--color--warning-500)",
        "background": "var(--wp--preset--color--warning-100)",
        "color": "var(--wp--preset--color--neutral-900)"
      },
      "card": {
        "padding": "var(--wp--preset--spacing--sm)",
        "borderRadius": "var(--wp--custom--border--radius)",
        "boxShadow": "none"
      },
      "highlight": {
        "background": "var(--wp--preset--color--primary-100)",
        "padding": "0.1em 0.4em",
        "borderRadius": "0.25em"
      },
      "accordion": {
        "height": "1.5px",
        "width": "12px",
        "animationDuration": "0s"
      },
      "submenu": {
        "boxShadow": "none"
      },
      "header": {
        "zIndex": "100",
        "position": "sticky",
        "top": "var(--wp-admin--admin-bar--height, 0px)",
        "background": "var(--wp--preset--color--neutral-0)",
        "scrollPadding": "5rem"
      },
      "button": {
        "padding": {
          "top": "1em",
          "right": "1.5em",
          "bottom": "1em",
          "left": "1.5em"
        },
        "fontSize": "var(--wp--preset--font-size--16)"
      }
    },
    "layout": {
      "contentSize": "min(calc(100% - var(--wp--preset--spacing--lg,3rem) * 2), 720px)",
      "wideSize": "min(calc(100% - var(--wp--preset--spacing--lg,3rem) * 2), 1200px)"
