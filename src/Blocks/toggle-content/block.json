{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "aegis/toggle-content",
  "version": "1.1.0",
  "title": "Toggle Content",
  "category": "design",
  "description": "One view in a Toggle content switcher (primary or secondary).",
  "icon": "screenoptions",
  "textdomain": "aegis",
  "parent": [
    "aegis/toggle"
  ],
  "keywords": [
    "toggle",
    "content",
    "switcher"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "className": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true
    }
  },
  "attributes": {
    "slot": {
      "type": "string",
      "default": "a",
      "enum": [
        "a",
        "b"
      ]
    }
  },
  "usesContext": [
    "aegis/toggleAllowNested",
    "aegis/toggleActiveSlot",
    "aegis/toggleDomId"
  ],
  "editorScript": "file:index.js",
  "style": "file:style-index.css",
  "render": "file:render.php"
}